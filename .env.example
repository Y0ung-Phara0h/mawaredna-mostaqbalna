# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# COMPOST CALCULATOR CONFIGURATION (Optional overrides)
# Defaults use verified lab bulk density (0.50–0.55 t/m³ = 500–550 kg/m³)
# and standard Egyptian Feddan agronomic ranges per crop & soil type.
# ---------------------------------------------------------------------------
# VITE_COMPOST_BULK_DENSITY_MIN_TONS_PER_M3="0.50"
# VITE_COMPOST_BULK_DENSITY_MAX_TONS_PER_M3="0.55"
# VITE_COMPOST_CROP_RATES_JSON=""
# VITE_COMPOST_SOIL_MULTIPLIERS_JSON=""

# ---------------------------------------------------------------------------
# QUOTATION SUBMISSION ENDPOINT (Google Apps Script Web App URL)
# Must return HTTP 200 with JSON {"ok": true} or {"status": "success"}.
# ---------------------------------------------------------------------------
VITE_QUOTATION_ENDPOINT=""

# ---------------------------------------------------------------------------
# APPROVED COMPANY CONTACT CHANNELS (Optional overrides)
# Phone and WhatsApp numbers automatically receive the (+2) Egypt prefix.
# ---------------------------------------------------------------------------
VITE_CONTACT_PHONE=""
VITE_CONTACT_WHATSAPP=""
VITE_CONTACT_EMAIL=""
VITE_CONTACT_LOCATION=""
# Paste a Google Maps "Embed a map" iframe src URL (https://www.google.com/maps/embed?pb=...)
# or a Google Maps location URL / coordinates (e.g., 26.1551, 32.7160)
VITE_CONTACT_LOCATION_EMBED_URL=""

# ---------------------------------------------------------------------------
# APPROVED SOCIAL MEDIA PROFILE (Facebook only)
# ---------------------------------------------------------------------------
VITE_SOCIAL_FACEBOOK=""
